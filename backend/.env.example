# ============================================================================
# CourseHub LMS — Backend Environment Configuration (.env.example)
# Copy this file to `backend/.env` and fill in your actual values.
# ============================================================================

# 1. Server & Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# 2. PostgreSQL Database (Supabase / Neon / Local PostgreSQL)
# DATABASE_URL: Transaction pooler connection string (port 6543 on Supabase)
# DIRECT_URL: Direct database connection string for Prisma migrations (port 5432)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# 3. JWT & RBAC Security Secrets (Generate strong 64-byte hex strings)
JWT_SECRET="replace_with_a_strong_random_64_char_secret_key"
JWT_EXPIRES_IN="7d"
ADMIN_SECRET_CODE="replace_with_your_institutional_admin_secret_code"
GOOGLE_CLIENT_ID="your_google_oauth_web_client_id"

# 4. Cloudinary Media Storage (Course PDFs, Videos, Submissions, Avatars)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 5. EmailJS Configuration (Verification & Forgot Password Emails)
# IMPORTANT: In your EmailJS Dashboard -> Account -> Security:
#   1. Copy both Public Key and Private Key below.
#   2. Enable "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID="your_emailjs_service_id"
EMAILJS_TEMPLATE_ID="your_emailjs_verification_template_id"
EMAILJS_RESET_TEMPLATE_ID="your_emailjs_password_reset_template_id"
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
EMAILJS_PRIVATE_KEY="your_emailjs_private_key"

# 6. Twilio Verify SMS OTP (optional password reset delivery)
# Create a Verify Service in Twilio Console. Use a test account/service for development.
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_VERIFY_SERVICE_SID="your_twilio_verify_service_sid"

# 7. Optional Account Provisioning & Seeding Passwords (Used only by `npm run seed` or Admin user creation)
DEFAULT_USER_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_FACULTY_PASSWORD=""
SEED_STUDENT_PASSWORD=""
