# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Application ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Authentication ──────────────────────────────────────────
# REQUIRED — used to sign and verify JWT tokens. Must be a
# strong, random string (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
ADMIN_SECRET_CODE=change-me

# ── Cloudinary — used for content/assignment file uploads ───
# (see src/config/cloudinary.js)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
