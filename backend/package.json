{
  "name": "prisma-scaffold",
  "version": "1.0.0",
  "description": "Node.js/Express server connected to Supabase PostgreSQL via Prisma",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=Integration",
    "test:integration": "jest --runInBand tests/authIntegration.test.js tests/courseIntegration.test.js tests/moduleIntegration.test.js tests/assignmentIntegration.test.js tests/apiSafetyIntegration.test.js",
    "test:coverage": "jest --runInBand --coverage",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html", "json-summary"],
    "collectCoverageFrom": [
      "src/Controllers/**/*.js",
      "src/Middleware/**/*.js",
      "src/routes/**/*.js",
      "src/server.js",
      "!src/lib/**",
      "!src/config/**"
    ],
    "testPathIgnorePatterns": ["/node_modules/"]
  },
  "dependencies": {
    "@emailjs/nodejs": "^5.0.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.5.0",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2"
  }
}
