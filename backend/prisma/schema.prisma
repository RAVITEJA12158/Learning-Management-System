generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                 @id @default(uuid())
  name                       String
  email                      String                 @unique
  passwordHash               String                 @map("password_hash")
  role                       Role
  profileImage               String?                @map("profile_image")
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  isVerified                 Boolean                @default(false) @map("is_verified")
  username                   String                 @unique
  verificationToken          String?                @unique @map("verification_token")
  verificationTokenExpires   DateTime?              @map("verification_token_expires")
  mobileNumber               String?                @map("mobile_number")
  announcements              Announcement[]
  gradedSubmissions          AssignmentSubmission[] @relation("SubmissionGradedBy")
  submissions                AssignmentSubmission[] @relation("SubmissionStudent")
  assignmentsCreated         Assignment[]           @relation("AssignmentCreatedBy")
  attendanceRecords          AttendanceRecord[]
  attendanceSessionsRecorded AttendanceSession[]
  contentCreated             Content[]              @relation("ContentCreatedBy")
  contentProgress            ContentProgress[]
  enrollments                CourseEnrollment[]
  courseInstructorOf         CourseInstructor[]
  coursesCreated             Course[]               @relation("CourseCreatedBy")
  discussionReplies          DiscussionReply[]
  discussions                Discussion[]
  notifications              Notification[]
  quizAttempts               QuizAttempt[]
  quizzesCreated             Quiz[]                 @relation("QuizCreatedBy")

  @@index([verificationToken])
  @@map("users")
}

model Course {
  id                 String              @id @default(uuid())
  courseCode         String              @map("course_code")
  title              String
  description        String?
  createdById        String              @map("created_by")
  semester           String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  announcements      Announcement[]
  assignments        Assignment[]
  attendanceSessions AttendanceSession[]
  enrollments        CourseEnrollment[]
  instructors        CourseInstructor[]
  createdBy          User                @relation("CourseCreatedBy", fields: [createdById], references: [id])
  discussions        Discussion[]
  gradeComponents    GradeComponent[]
  modules            Module[]
  quizzes            Quiz[]

  @@unique([courseCode, semester])
  @@index([createdById])
  @@map("courses")
}

model CourseEnrollment {
  id         String           @id @default(uuid())
  courseId   String           @map("course_id")
  studentId  String           @map("student_id")
  enrolledAt DateTime         @default(now()) @map("enrolled_at")
  status     EnrollmentStatus @default(ACTIVE)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
  @@map("course_enrollments")
}

model CourseInstructor {
  id        String @id @default(uuid())
  courseId  String @map("course_id")
  facultyId String @map("faculty_id")
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty   User   @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([courseId, facultyId])
  @@index([facultyId])
  @@map("course_instructors")
}

model Module {
  id          String    @id @default(uuid())
  courseId    String    @map("course_id")
  title       String
  description String?
  position    Int
  isPublished Boolean   @default(false) @map("is_published")
  releaseAt   DateTime? @map("release_at")
  content     Content[]
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("modules")
}

model Content {
  id          String            @id @default(uuid())
  moduleId    String            @map("module_id")
  title       String
  type        ContentType
  contentUrl  String?           @map("content_url")
  description String?
  position    Int
  isPublished Boolean           @default(false) @map("is_published")
  createdById String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  createdBy   User              @relation("ContentCreatedBy", fields: [createdById], references: [id])
  module      Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    ContentProgress[]

  @@index([moduleId])
  @@index([createdById])
  @@map("content")
}

model Assignment {
  id                  String                 @id @default(uuid())
  courseId            String                 @map("course_id")
  title               String
  description         String?
  maxMarks            Decimal                @map("max_marks") @db.Decimal(6, 2)
  dueDate             DateTime               @map("due_date")
  allowLateSubmission Boolean                @default(false) @map("allow_late_submission")
  createdById         String                 @map("created_by")
  createdAt           DateTime               @default(now()) @map("created_at")
  submissions         AssignmentSubmission[]
  course              Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy           User                   @relation("AssignmentCreatedBy", fields: [createdById], references: [id])

  @@index([courseId])
  @@index([createdById])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String           @map("assignment_id")
  studentId    String           @map("student_id")
  fileUrl      String           @map("file_url")
  submittedAt  DateTime         @default(now()) @map("submitted_at")
  status       SubmissionStatus
  marks        Decimal?         @db.Decimal(6, 2)
  feedback     String?
  gradedById   String?          @map("graded_by")
  gradedAt     DateTime?        @map("graded_at")
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  gradedBy     User?            @relation("SubmissionGradedBy", fields: [gradedById], references: [id])
  student      User             @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([gradedById])
  @@map("assignment_submissions")
}

model Quiz {
  id              String        @id @default(uuid())
  courseId        String        @map("course_id")
  title           String
  description     String?
  durationMinutes Int           @map("duration_minutes")
  maxAttempts     Int           @default(1) @map("max_attempts")
  startTime       DateTime      @map("start_time")
  endTime         DateTime      @map("end_time")
  totalMarks      Decimal       @map("total_marks") @db.Decimal(6, 2)
  createdById     String        @map("created_by")
  questions       Question[]
  attempts        QuizAttempt[]
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("QuizCreatedBy", fields: [createdById], references: [id])

  @@index([courseId])
  @@index([createdById])
  @@map("quizzes")
}

model Question {
  id           String           @id @default(uuid())
  quizId       String           @map("quiz_id")
  questionText String           @map("question_text")
  questionType QuestionType     @map("question_type")
  marks        Decimal          @db.Decimal(6, 2)
  position     Int
  options      QuestionOption[]
  quiz         Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers      QuizAnswer[]

  @@index([quizId])
  @@map("questions")
}

model QuestionOption {
  id                String       @id @default(uuid())
  questionId        String       @map("question_id")
  optionText        String       @map("option_text")
  isCorrect         Boolean      @default(false) @map("is_correct")
  question          Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedInAnswers QuizAnswer[]

  @@index([questionId])
  @@map("question_options")
}

model QuizAttempt {
  id          String        @id @default(uuid())
  quizId      String        @map("quiz_id")
  studentId   String        @map("student_id")
  startedAt   DateTime      @default(now()) @map("started_at")
  submittedAt DateTime?     @map("submitted_at")
  score       Decimal?      @db.Decimal(6, 2)
  status      AttemptStatus @default(IN_PROGRESS)
  answers     QuizAnswer[]
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([studentId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id               String          @id @default(uuid())
  attemptId        String          @map("attempt_id")
  questionId       String          @map("question_id")
  selectedOptionId String?         @map("selected_option_id")
  textAnswer       String?         @map("text_answer")
  marksAwarded     Decimal?        @map("marks_awarded") @db.Decimal(6, 2)
  attempt          QuizAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("quiz_answers")
}

model Announcement {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  createdById String   @map("created_by")
  title       String
  message     String
  createdAt   DateTime @default(now()) @map("created_at")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([courseId])
  @@index([createdById])
  @@map("announcements")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model AttendanceSession {
  id          String             @id @default(uuid())
  courseId    String             @map("course_id")
  date        DateTime           @db.Date
  createdById String             @map("created_by")
  records     AttendanceRecord[]
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User               @relation(fields: [createdById], references: [id])

  @@index([courseId])
  @@index([createdById])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String            @map("session_id")
  studentId String            @map("student_id")
  status    AttendanceStatus
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

model Discussion {
  id        String            @id @default(uuid())
  courseId  String            @map("course_id")
  userId    String            @map("user_id")
  title     String
  content   String
  createdAt DateTime          @default(now()) @map("created_at")
  replies   DiscussionReply[]
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("discussions")
}

model DiscussionReply {
  id           String     @id @default(uuid())
  discussionId String     @map("discussion_id")
  userId       String     @map("user_id")
  content      String
  createdAt    DateTime   @default(now()) @map("created_at")
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@map("discussion_replies")
}

model ContentProgress {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  contentId   String    @map("content_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  content     Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([contentId])
  @@map("content_progress")
}

model GradeComponent {
  id       String  @id @default(uuid())
  courseId String  @map("course_id")
  name     String
  type     String
  weight   Decimal @db.Decimal(5, 2)
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("grade_components")
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum ContentType {
  PDF
  VIDEO
  LINK
  FILE
  TEXT
}

enum SubmissionStatus {
  SUBMITTED
  LATE
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  NUMERICAL
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum NotificationType {
  ANNOUNCEMENT
  ASSIGNMENT
  QUIZ
  GRADE
  DISCUSSION
  SYSTEM
}
