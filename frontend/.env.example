# ============================================================================
# CourseHub LMS — Frontend Environment Configuration (.env.example)
# Copy this file to `frontend/.env` and fill in your actual values.
# ============================================================================

# Base URL for the Express Backend API (defaults to `/api` via Vite proxy in dev)
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id

# Optional Supabase client configuration (if used for client-side storage/realtime)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional Demo Login Buttons on /login (Set to "true" ONLY in local/staging demo environments)
VITE_ENABLE_DEMO_ACCOUNTS=false
VITE_DEMO_STUDENT_EMAIL=
VITE_DEMO_STUDENT_PASSWORD=
VITE_DEMO_FACULTY_EMAIL=
VITE_DEMO_FACULTY_PASSWORD=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_ADMIN_SECRET_CODE=
