# The Selenium suite defaults to localhost:3000 (Vite) and stays opt-in.
LMS_RUN_SELENIUM=1
LMS_BASE_URL=http://localhost:3000
LMS_HEADLESS=true

# Supply test-only credentials. Do not put production credentials here.
LMS_TEST_STUDENT_EMAIL=
LMS_TEST_STUDENT_PASSWORD=
LMS_TEST_FACULTY_EMAIL=
LMS_TEST_FACULTY_PASSWORD=
LMS_TEST_ADMIN_EMAIL=
LMS_TEST_ADMIN_PASSWORD=
LMS_TEST_ADMIN_SECRET_CODE=
LMS_TEST_NEW_USER_PASSWORD=
LMS_TEST_COURSE_ID=

# Set both only after confirming backend/.env points to a disposable TEST database.
# Mutation workflows include registration, enrollment, assignment, quiz,
# discussion, announcement, and progress records.
LMS_TEST_DB_CONFIRMED=false
LMS_TEST_ALLOW_MUTATIONS=false
